+def _portas_ativas(evento: dict[str, Any], texto: str) -> dict[str, list[str]]:
+    """Retorna as portas editoriais acionadas e as evidências que as acionaram."""
+    portas = {}
+    for nome, termos in PORTAS_TEXTO.items():
+        sinais = _matches(texto, termos)
+        # Negação explícita não conta como dano/risco/sanção confirmado.
+        # Decisões regulatórias continuam como porta, inclusive quando negam um pedido.
+        if nome != "P4_DECISAO_REGULATORIA_MATERIAL":
+            sinais = [termo for termo in sinais
+                      if _natureza_evidencia(texto, termo) != "NEGATIVA_EXPLICITA"]
+        if sinais:
+            portas[nome] = sinais
+    campos_novidade = ("novo_ou_alterado", "evento_novo", "fato_novo")
+    novidade_confirmada = any(evento.get(campo) is True for campo in campos_novidade)
+    for porta, campos in PORTAS_ESTRUTURADAS.items():
+        valores = []
+        for campo in campos:
+            valor = evento.get(campo)
+            ativo = bool(valor) and valor is not False
+            if campo in {"empresa_watchlist", "ativo_watchlist", "projeto_estrategico"}:
+                ativo = ativo and novidade_confirmada
+            if ativo:
+                valores.append(f"{campo}={valor}")
+        if valores:
+            portas.setdefault(porta, []).extend(valores)
+    return {nome: evidencias for nome, evidencias in portas.items() if evidencias}
+
+
+def _natureza_evidencia(texto: str, termo: str) -> str:
+    """Rotula a frase do sinal; não converte alegação/risco em fato confirmado."""
+    termo_norm = normalizar(termo)
+    for frase in _frases(texto):
+        frase_norm = normalizar(frase)
+        if termo_norm not in frase_norm:
+            continue
+        if any(marcador in frase_norm for marcador in NEGACAO_EXPLICITA):
+            return "NEGATIVA_EXPLICITA"
+        if any(marcador in frase_norm for marcador in MARCADORES_RISCO):
+            return "RISCO_OU_POSSIBILIDADE"
+        if any(marcador in frase_norm for marcador in MARCADORES_ALEGACAO):
+            return "ALEGACAO_OU_INVESTIGACAO"
+        return "SINAL_TEXTUAL_A_CLASSIFICAR"
+    return "AUSENCIA_DE_CONTEXTO"
+
+
+def _classificar_semantica_evento(texto: str) -> str:
+    """Distingue pedido, ato efetivado, risco, alegação e negativa sem inferir fatos."""
+    t = normalizar(texto)
+    frases = [normalizar(x) for x in _frases(texto)]
+    if not t.strip():
+        return "AUSENCIA_DE_INFORMACAO"
+    if any(any(m in f for m in NEGACAO_EXPLICITA) for f in frases):
+        return "NEGATIVA_EXPLICITA"
+    if any(any(m in f for m in MARCADORES_ALEGACAO) for f in frases):
+        return "ALEGACAO_OU_INVESTIGACAO"
+    if any(any(m in f for m in MARCADORES_RISCO) for f in frases):
+        return "RISCO_OU_POSSIBILIDADE"
+    if any(any(m in f for m in MARCADORES_DECISAO_NEGATIVA) for f in frases):
+        return "DECISAO_NEGATIVA"
+    if any(any(m in f for m in MARCADORES_PEDIDO) for f in frases):
+        return "PEDIDO_AINDA_NAO_DECIDIDO"
+    if any(any(m in f for m in MARCADORES_ATO_EFETIVADO) for f in frases):
+        return "ATO_OU_DECISAO_EFETIVADA"
+    return "SINAL_TEXTUAL_SEM_STATUS_CONCLUSIVO"
+
