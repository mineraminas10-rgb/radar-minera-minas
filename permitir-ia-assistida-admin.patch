Subject: [PATCH] Permitir leitura assistida de IA para perfil Admin

---
 index.html | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/index.html b/index.html
index 6fc1977..53b8b6b 100644
--- a/index.html
+++ b/index.html
@@ -502,15 +502,16 @@ const ROTULO_ROLE = { master: 'Master', admin: 'Admin' };
 // Só existem DOIS perfis:
 //   master -> tudo: todas as empresas, usuários, API, consumo, limites, auditoria.
 //   admin  -> opera o RADAR (fila, checklist, carteiras) nas empresas que o master liberou
-//             em usuario_empresas. NÃO vê usuários, API, segredos, consumo, limites nem auditoria.
+//             em usuario_empresas; pode consultar os detalhes de IA assistida dos eventos visíveis.
+//             NÃO vê usuários, API, segredos, consumo, limites nem auditoria.
 //   editorial          -> mudar status do evento e marcar checklist
 //   checklist_desmarcar-> apagar linha do checklist
 //   carteiras_editar   -> criar/editar/excluir carteiras, pesos e fontes
 //   cliente_criar      -> botão "+ Novo cliente" (só master)
 //   admin_painel       -> menu ADMIN (empresas, usuários, API, consumo, auditoria) — só master
 const PERMISSOES = {
-  master: { editorial: true, checklist_desmarcar: true, carteiras_editar: true, cliente_criar: true,  admin_painel: true  },
-  admin:  { editorial: true, checklist_desmarcar: true, carteiras_editar: true, cliente_criar: false, admin_painel: false },
+  master: { editorial: true, checklist_desmarcar: true, carteiras_editar: true, cliente_criar: true,  admin_painel: true, ia_assistida: true },
+  admin:  { editorial: true, checklist_desmarcar: true, carteiras_editar: true, cliente_criar: false, admin_painel: false, ia_assistida: true },
 };
 const MSG_SEM_PERMISSAO = 'Seu perfil não tem permissão para esta ação (ou o registro não pertence à sua empresa). Nada foi alterado.';
 
@@ -1484,8 +1485,8 @@ function cardHTML(item){
       <summary>Fontes e evidências (${docs.length + evid.length})</summary>
       <ul class="srcList">${srcItems}</ul>
     </details>
-    ${pode('admin_painel') ? `<details class="iaEvento" data-ia-event="${esc(e.id)}" data-revisao="${esc(e.revisao_humana || '')}">
-      <summary>IA assistida (somente master)</summary>
+    ${pode('ia_assistida') ? `<details class="iaEvento" data-ia-event="${esc(e.id)}" data-revisao="${esc(e.revisao_humana || '')}">
+      <summary>IA assistida — leitura</summary>
       <div class="iaBody sub" style="margin-top:6px">Abra para carregar…</div>
     </details>` : ''}
     <details>
@@ -2767,6 +2768,7 @@ async function pilotoPausar(){
 // ---------------------------------------------------------------------------
 async function iaEventoCarregar(det){
   const eventId = det.dataset.iaEvent; const box = det.querySelector('.iaBody'); if (!box || det.dataset.carregado === '1') return;
+  if (!pode('ia_assistida')) { box.textContent = 'Sem permissão.'; return; }
   box.textContent = 'Carregando…';
   try {
     const r = await sb.from('api_execucoes').select('id, status, modelo, custo_estimado_usd, versao_prompt, data_inicio, erro, motivo_bloqueio, resposta_texto, metadata')
